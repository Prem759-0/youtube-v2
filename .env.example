# Demo environment file for GitHub repo
# Copy this file to .env.local and replace placeholder values with your real credentials.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ENV=development

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_SIGNING_SECRET=whsec_your_clerk_webhook_signing_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Database (Neon / Postgres)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Mux Video
MUX_TOKEN_ID=mux_token_id
MUX_TOKEN_SECRET=mux_token_secret
MUX_WEBHOOK_SECRET=mux_webhook_secret

# UploadThing
UPLOADTHING_SECRET=sk_live_or_test_your_uploadthing_secret
UPLOADTHING_APP_ID=your_uploadthing_app_id

# OpenRouter / AI Titles & Descriptions
OPENROUTER_API_KEY=your_openrouter_api_key

# Leonardo AI / AI Thumbnails
LEONARDO_API_KEY=your_leonardo_api_key

# Upstash Workflow / Queue
QSTASH_TOKEN=your_qstash_token
UPSTASH_WORKFLOW_URL=https://your-workflow-endpoint.upstash.dev

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Optional: Mux public URLs
NEXT_PUBLIC_MUX_IMAGE_BASE_URL=https://image.mux.com
NEXT_PUBLIC_MUX_STREAM_BASE_URL=https://stream.mux.com
